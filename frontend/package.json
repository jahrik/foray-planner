{
  "name": "foray-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Foray Planner web client (TypeScript + Vite + Leaflet)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:api": "uv run --project .. foray openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
