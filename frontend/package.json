{
  "name": "foray-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Foray Planner web client (TypeScript + Vite + Leaflet)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "preview": "vite preview",
    "gen:api": "uv run --project .. foray openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
