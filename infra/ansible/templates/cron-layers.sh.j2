#!/bin/sh
# Managed by the foray-planner ansible role
#
# camps/dispersed stay home-radius only (on-demand, see AGENTS.md); land/trails run
# coverage-wide (--all) so they're pre-cached for every configured region, not just home.
# --pull always: refresh the local :latest each tick so a stale image can't fail apply_schema (#277).
# `foray job` (issue #332) takes its own Postgres advisory lock keyed on the job name, so the
# outer `flock -n` this used to run under is redundant - dropped. Each half gets its own job
# name (and job_runs row) since `foray job` wraps a single foray subcommand. Container names
# let migrate.yml (infra/ansible/tasks/deploy/migrate.yml) stop a still-running instance
# before a schema-breaking migration.
#
# No `set -e`: camps and land run independently on purpose (each is its own `foray job`, so
# each records its own job_runs outcome) - a `set -e` here would abort before land/trails even
# starts if camps/dispersed failed first, reintroducing the sibling-blocking bug the `foray
# job` wrapper was built to remove. Track both exit codes and fail the script (for any outer
# supervision watching cron's own exit status) only after both have been attempted.
status=0
docker run --rm --name foray-cron-layers-camps --pull always --env-file /opt/foray-planner/foray.env \
  {{ foray_app_image }} \
  foray job layers-camps -- refresh --with camps,dispersed || status=$?
docker run --rm --name foray-cron-layers-land --pull always --env-file /opt/foray-planner/foray.env \
  {{ foray_app_image }} \
  foray job layers-land -- refresh --with land,trails --all || status=$?
exit "$status"
