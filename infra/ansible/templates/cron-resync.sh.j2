#!/bin/sh
# Managed by the foray-planner ansible role
# --pull always: refresh the local :latest each tick so a stale image can't fail apply_schema (#277).
exec flock -n /tmp/foray-resync.lock \
  docker run --rm --pull always --env-file /opt/foray-planner/foray.env \
    {{ foray_app_image }} \
    foray resync --batch-size {{ foray_resync_batch_size }}
