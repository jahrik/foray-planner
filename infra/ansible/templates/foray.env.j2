# Managed by the foray-planner ansible role
PGHOST={{ foray_db_host }}
PGPORT={{ foray_db_port }}
PGUSER={{ foray_db_user }}
PGPASSWORD={{ foray_db_password }}
PGDATABASE={{ foray_do_db_name }}
RIDB_API_KEY={{ foray_ridb_api_key }}
FORAY_HOME__LAT={{ foray_home_lat }}
FORAY_HOME__LNG={{ foray_home_lng }}
FORAY_HOME__RADIUS_KM={{ foray_home_radius_km }}
{% if foray_basemap_url | trim %}
FORAY_BASEMAP_URL={{ foray_basemap_url | trim }}
{% endif %}
{% if foray_terrain_url | trim %}
FORAY_TERRAIN_URL={{ foray_terrain_url | trim }}
{% endif %}
{% if foray_spaces_access_key_id | trim and foray_spaces_secret_access_key | trim %}
# The app's own runtime read/write access to the same Space the basemap archive lives in
# (issue #334 PR 1) - region_satellite's rasters and the bulk-snapshot staging path, under
# separate key prefixes (satellite/, bulk/). Unset -> region_satellite falls back to storing
# bytes in Postgres directly, and `foray ingest-bulk`/`stage-snapshot` refuse to run.
FORAY_SPACES__ACCESS_KEY_ID={{ foray_spaces_access_key_id | trim }}
FORAY_SPACES__SECRET_ACCESS_KEY={{ foray_spaces_secret_access_key | trim }}
FORAY_SPACES__BUCKET={{ foray_basemap_space_name }}
FORAY_SPACES__REGION={{ foray_basemap_region }}
{% endif %}
