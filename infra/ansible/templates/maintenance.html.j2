{# Managed by the foray-planner ansible role. Fully self-contained - no external assets,
   since it has to render when the origin is down. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="60">
<meta name="robots" content="noindex">
<title>Foray Planner - back shortly</title>
<style>
  :root { color-scheme: light dark; }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #f4f1ea;
    color: #2c2a26;
  }
  main { max-width: 30rem; padding: 2rem; text-align: center; }
  .mark { font-size: 3.5rem; line-height: 1; }
  h1 { font-size: 1.5rem; margin: 1rem 0 0.5rem; }
  p { margin: 0.5rem 0; color: #5c574d; }
  .hint { font-size: 0.875rem; margin-top: 1.5rem; }
  @media (prefers-color-scheme: dark) {
    body { background: #1b1a17; color: #e8e4da; }
    p { color: #a8a294; }
  }
</style>
</head>
<body>
<main>
  <div class="mark">&#127812;</div>
  <h1>Foray Planner is down for maintenance</h1>
  <p>We&rsquo;re running a scheduled database update. This usually takes a few minutes.</p>
  <p class="hint">This page refreshes itself &mdash; no need to reload.</p>
</main>
</body>
</html>
