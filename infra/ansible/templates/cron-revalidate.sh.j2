#!/bin/sh
# Managed by the foray-planner ansible role
# --pull always: refresh the local :latest each tick so a stale image can't fail apply_schema (#277).
# `foray job` (issue #332) takes its own Postgres advisory lock keyed on the job name, so the
# outer `flock -n` this used to run under is redundant - dropped. The container name lets
# migrate.yml (infra/ansible/tasks/deploy/migrate.yml) stop a still-running instance before a
# schema-breaking migration.
#
# A fixed --name means an overlapping tick (previous run still going) would otherwise fail at
# `docker run` itself ("name already in use") before `foray job`'s own advisory-lock overlap
# guard ever runs - a hard docker error instead of the wrapper's clean job_runs skip. Check for
# a still-running container under that name first and skip this tick the same way the wrapper
# would.
name=foray-cron-revalidate
if [ -n "$(docker ps -q -f "name=^/${name}\$" -f status=running)" ]; then
  echo "$name: previous run still in progress, skipping this tick"
  exit 0
fi
docker run --rm --name "$name" --pull always --env-file /opt/foray-planner/foray.env \
  {{ foray_app_image }} \
  foray job revalidate -- revalidate
