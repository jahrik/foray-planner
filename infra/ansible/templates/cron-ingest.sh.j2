#!/bin/sh
# Managed by the foray-planner ansible role
# --pull always: refresh the local :latest each tick so a stale image can't fail apply_schema (#277).
# `foray job` (issue #332) takes its own Postgres advisory lock keyed on the job name, so the
# outer `flock -n` this used to run under is redundant - dropped. The container name lets
# migrate.yml (infra/ansible/tasks/deploy/migrate.yml) stop a still-running instance before a
# schema-breaking migration.
docker run --rm --name foray-cron-ingest --pull always --env-file /opt/foray-planner/foray.env \
  {{ foray_app_image }} \
  foray job ingest -- ingest --countries
